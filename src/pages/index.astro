---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import stack from '../data/stack.json';
import skills from '../data/skills.json';

const { description } = profile;
---

<Base title={`${profile.name} — ${profile.role.toLowerCase()}`} description={description}>
  <nav class="nav" aria-label="Разделы">
    <a href="#experience">Опыт</a>
    <a href="#stats">Результаты</a>
    <a href="#skills">Навыки</a>
    <a href="#projects">Проекты</a>
    <a href="#contact">Контакт</a>
  </nav>

  <main>
    <section id="about" class="about">
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      {profile.lead.map((p) => <p class="lead">{p}</p>)}
      <p class="status">{profile.status}</p>
    </section>

    <section id="experience">
      <h2>Опыт</h2>
      <ol class="experience" role="list">
        {profile.experience.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.role}{e.place && <span class="place"> · {e.place}</span>}</h3>
              {e.text && <p>{e.text}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="stats">
      <h2>Результаты</h2>
      <dl class="stats">
        {profile.stats.map((s) => (
          <div class="stat">
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="skills">
      <h2>Навыки</h2>
      {skills.groups.map((g) => (
        <div class="skill-group">
          <h3>{g.title}</h3>
          <ul class="skills">
            {g.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section id="projects">
      <h2>Проекты</h2>
      <div class="projects">
        {stack.projects.map((p) => (
          <article class="project">
            <h3>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h3>
            <p class="project-what">{p.what}</p>
            <ul class="tech" role="list">{p.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="note">{stack.note}</p>
    </section>

    <section id="contact">
      <h2>Контакт</h2>
      <ul class="contacts">
        {profile.contacts.map((c) => (
          <li><span>{c.label}</span> <a href={c.href}>{c.value}</a></li>
        ))}
      </ul>
    </section>
  </main>
</Base>
